{
  "name": "gozargah",
  "version": "1.2.0",
  "private": true,
  "description": "Gozargah - a beautiful, secure, multi-user VLESS/Trojan panel on Cloudflare Workers with real byte accounting, per-operator tuning, Xray auto-best and D1 storage",
  "main": "src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/build-preview.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.24.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "wrangler": "^3.99.0"
  }
}
